# Copy to .dev.vars for local development. Never commit .dev.vars.
# Every name here is validated at startup by server/env.ts.

# Local Postgres (Neon branch or Docker). In staging/production the HYPERDRIVE binding is used instead.
DATABASE_URL=postgres://k3:k3@localhost:5432/k3_dev

# Better Auth: 32+ random bytes, base64. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Stripe (phase 5 and 8). Test-mode keys only outside production.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PLATFORM_WEBHOOK_SECRET=

# Resend (phase 6)
RESEND_API_KEY=
