/**
 * K3 Dashboard Worker configuration.
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * One Worker serves the dashboard (React Router), the public API and webhooks (Hono),
 * queue consumers and cron handlers. Environments differ only in names, bindings and secrets.
 *
 * The Cloudflare Vite plugin resolves the environment at BUILD time: CLOUDFLARE_ENV=staging
 * (or production) `npm run build`, then plain `wrangler deploy`; `--env` on deploy is ignored
 * because wrangler is redirected to build/server/wrangler.json. See deploy.yml.
 *
 * Secrets (never in this file): see .dev.vars.example. The deploy workflow pushes them from
 * GitHub environment secrets; by hand, after such a build: wrangler secret put <NAME>
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "k3-dashboard",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./workers/app.ts",
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"vars": {
		"APP_ENV": "development",
		"APP_ORIGIN": "http://localhost:5173"
	},
	/**
	 * Hyperdrive: connection pooling to the environment's Postgres.
	 * The id is created once per environment in the dashboard (docs/LAUNCH.md, step 2).
	 * Locally, DATABASE_URL in .dev.vars is used instead (see server/env.ts).
	 */
	// "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<created per environment>" }],
	"env": {
		"staging": {
			"name": "k3-dashboard-staging",
			"vars": { "APP_ENV": "staging", "APP_ORIGIN": "https://staging-app.kermitwebcraft.com", "EMAIL_FROM_ADDRESS": "no-reply@mail.kermitwebcraft.com" },
			"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "3b1655f1de914e7cb868752be79249fb" }]
		},
		"production": {
			"name": "k3-dashboard-production",
			"vars": { "APP_ENV": "production", "APP_ORIGIN": "https://app.kermitwebcraft.com", "EMAIL_FROM_ADDRESS": "no-reply@mail.kermitwebcraft.com" },
			"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "28aad2c14c524dea95be092d33c619b1" }]
		}
	}
}
